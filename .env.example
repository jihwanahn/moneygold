# ============================================================
# moneygold — 환경변수 템플릿
# 사용법: 이 파일을 .env로 복사한 뒤 값 채우기
#   cp .env.example .env
# .env는 .gitignore에 등록되어 있어 커밋 안 됨.
#
# 처음 사용자는 아래 ⭐ 표시된 4줄(KRX_ID/PW + KIS_APP_KEY/SECRET)만
# 채워도 동작합니다. 나머지는 기본값으로 두세요.
# ============================================================

# -----------------------------
# KRX 로그인 (pykrx가 요구함, 종목 마스터 sync 전용)
# -----------------------------
# data.krx.co.kr 계정 (무료 회원가입). pykrx가 마스터 조회에 사용.
KRX_ID=                  # ⭐ 필수
KRX_PW=                  # ⭐ 필수

# -----------------------------
# KIS Open API (read-only)
# -----------------------------
# 한국투자증권 OpenAPI 신청 → 앱키/시크릿 발급 (실전투자, read-only 권한)
#   https://apiportal.koreainvestment.com
# 주문 API는 호출하지 않으므로 read-only 권한이면 충분.
KIS_APP_KEY=             # ⭐ 필수
KIS_APP_SECRET=          # ⭐ 필수

# 계좌번호 (선택). 보유 종목 자동 감지 기능에서만 사용.
# 형식: "12345678-01" → KIS_ACCOUNT_NO=12345678, KIS_ACCOUNT_PROD_CD=01
KIS_ACCOUNT_NO=
KIS_ACCOUNT_PROD_CD=01

# -----------------------------
# 사이징 (시그널 *표시*용 — 자동 주문 아님)
# -----------------------------
DEFAULT_EQUITY_KRW=10000000
MAX_RISK_PER_TRADE_PCT=1.0
MAX_POSITION_WEIGHT_PCT=20.0
MAX_POSITIONS=10

# -----------------------------
# 유니버스 필터
# -----------------------------
LIQUIDITY_MIN_KRW=1000000000
MCAP_MIN_KRW=50000000000

# 미국 유니버스: 'sp500' (≈505) 또는 'nasdaq_trader' (≈6-7k → mcap 컷으로 좁힘)
US_SOURCE=nasdaq_trader
US_MCAP_MIN_USD=300000000

# -----------------------------
# 전략 파라미터 (백테스트 후 확정)
# -----------------------------
STAGE2_REQUIRE_INST_FLOW=true
RS_RANK_MIN=70

# Minervini 조건 3: sma200_today > sma200_{N}봉전 (TV·책 일반 22일=1개월)
SMA200_SLOPE_LOOKBACK=22

# Weinstein Stage 분류기 (TradingView 일반 구현 일치, RS 조건 없음)
STAGE_MA_LENGTH=150
STAGE_MA_TYPE=SMA
STAGE_SLOPE_LOOKBACK=20
STAGE_SLOPE_THRESHOLD_PCT=0.001
STAGE_BAND_PCT=0.03

# Darvas Box (PR4 sweep G3, 원전 충실)
BOX_HIGH_LOOKBACK=20
BOX_HIGH_CONFIRM=1
BOX_HEIGHT_MAX_PCT=12
BOX_VALID_MIN_DAYS=5
BOX_STALE_DAYS=60
BREAKOUT_BUFFER=0.003
BREAKOUT_VOLUME_MULT=1.0
GAP_BUY_ON_PULLBACK=true
FUNDAMENTAL_REQUIRED=false

# -----------------------------
# 알림 (PR6)
# -----------------------------
NOTIFY_CHANNEL=console,file
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# -----------------------------
# MCP
# -----------------------------
MCP_SERVER=korea-stock-analyzer

# -----------------------------
# 경로
# -----------------------------
DATA_DIR=./store
RESULT_DIR=./result

# -----------------------------
# 운영
# -----------------------------
LOG_LEVEL=INFO
TIMEZONE=Asia/Seoul
BENCHMARK_INDEX=KOSPI
